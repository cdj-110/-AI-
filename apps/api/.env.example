DATABASE_URL="postgresql://weikong:CHANGE_ME_LOCAL_ONLY@localhost:5432/weikong_iot?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
# 专用 EMQX API 密钥，禁止回退到 Dashboard 管理账号登录。
EMQX_API_URL=http://localhost:18083/api/v5
EMQX_API_KEY=
EMQX_API_SECRET=
EMQX_API_CREDENTIALS_FILE=
JWT_SECRET=
# 生产环境请设置独立的高强度随机密钥；未设置时兼容使用 JWT_SECRET 派生。
FACTORY_CREDENTIAL_ENCRYPTION_KEY=
# Ed25519 PKCS#8 DER 私钥的 Base64，仅配置在管理平台，严禁放入网关或提交仓库。
ACTIVATION_SIGNING_PRIVATE_KEY=
ACTIVATION_SIGNING_KEY_ID=
# 0 表示永久有效；正整数表示有效天数，仅影响新签发授权。
ACTIVATION_LICENSE_DAYS=0
ACTIVATION_CLOUD_API=https://cloud.example.com/api
ACTIVATION_REMOTE_ACCESS_ENDPOINT=wss://cloud.example.com/remote-agent
OTA_TRUSTED_PUBLIC_KEYS=
OTA_DOWNLOAD_SECRET=
OTA_PUBLIC_BASE_URL=https://cloud.example.com
OTA_PACKAGE_DIR=/var/lib/weikong/ota
JWT_EXPIRES_IN=12h
# 真实用户操作才会续期；后台轮询和实时数据不续期。
AUTH_ADMIN_IDLE_SECONDS=1800
AUTH_TENANT_IDLE_SECONDS=3600
AUTH_SESSION_ABSOLUTE_SECONDS=43200
# 注册及找回密码验证码邮件；授权码只写入部署环境，严禁提交仓库。
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=notice@example.com
MAIL_PASSWORD=
# 生产环境优先使用凭证文件；设置后可以不配置 MAIL_PASSWORD。
MAIL_PASSWORD_FILE="CHANGE_ME_LOCAL_ONLY"
MAIL_FROM="微控物联云平台 <notice@example.com>"
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60
# 支付宝沙箱联调；密钥文件必须保存在仓库外的受限目录。
ALIPAY_ENABLED=false
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_SANDBOX_TEST_AMOUNT_CENTS=1
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
PORT=3100
TIMESCALE_DATABASE_URL="postgresql://weikong:CHANGE_ME_LOCAL_ONLY@localhost:5433/weikong_ts"
# Default off. Review /api/subscriptions/customers/:tenantId/history-cleanup-impact before enabling.
HISTORY_CLEANUP_ENABLED=false
# ISO timestamp with timezone. First cleanup cannot run until 7 days after this timestamp.
HISTORY_CLEANUP_ACTIVATED_AT=
REMOTE_ACCESS_PORT=3201
# 生产环境建议配置独立 HTTPS 域名，例如 https://remote.example.com
REMOTE_ACCESS_PUBLIC_URL=
# 浏览器持续有请求时自动续期；无操作超过该时间后会话失效。
REMOTE_ACCESS_SESSION_IDLE_SECONDS=900
# 一次性连接链接有效期，不会超过会话空闲有效期。
REMOTE_ACCESS_LINK_TTL_SECONDS=900
# 浏览器 Cookie 保留时间；实际访问权限仍受 Redis 空闲超时控制。
REMOTE_ACCESS_COOKIE_MAX_AGE_SECONDS=604800
