      "baudRate": 9600,
      "dataBits": 8,
      "stopBits": 1,
      "parity": "none",
      "enabled": true
    },
    {
      "name": "RS485-2",
      "port": "/dev/ttyS2",
      "baudRate": 9600,
      "dataBits": 8,
