set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)

if(NOT DEFINED ENV{RK3506_TOOLCHAIN_ROOT})
    message(FATAL_ERROR "RK3506_TOOLCHAIN_ROOT must point to the Buildroot host/toolchain directory")
endif()
if(NOT DEFINED ENV{RK3506_SYSROOT})
    message(FATAL_ERROR "RK3506_SYSROOT must point to the RK3506 target sysroot")
endif()

set(RK3506_TOOLCHAIN_ROOT "$ENV{RK3506_TOOLCHAIN_ROOT}")
set(RK3506_SYSROOT "$ENV{RK3506_SYSROOT}")
if(DEFINED ENV{RK3506_TOOLCHAIN_PREFIX})
    set(RK3506_TOOLCHAIN_PREFIX "$ENV{RK3506_TOOLCHAIN_PREFIX}")
else()
    set(RK3506_TOOLCHAIN_PREFIX "arm-buildroot-linux-gnueabihf")
endif()

set(CMAKE_C_COMPILER "${RK3506_TOOLCHAIN_ROOT}/bin/${RK3506_TOOLCHAIN_PREFIX}-gcc")
set(CMAKE_CXX_COMPILER "${RK3506_TOOLCHAIN_ROOT}/bin/${RK3506_TOOLCHAIN_PREFIX}-g++")
set(CMAKE_SYSROOT "${RK3506_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${RK3506_SYSROOT}")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
