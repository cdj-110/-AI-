set(CMAKE_SYSTEM_NAME Linux)

if(NOT DEFINED ENV{WK_TOOLCHAIN_ROOT})
    message(FATAL_ERROR "WK_TOOLCHAIN_ROOT must point to the Buildroot host/toolchain directory")
endif()
if(NOT DEFINED ENV{WK_SYSROOT})
    message(FATAL_ERROR "WK_SYSROOT must point to the target sysroot")
endif()

set(WK_TARGET_ARCH "$ENV{WK_TARGET_ARCH}")
if(WK_TARGET_ARCH STREQUAL "arm64" OR WK_TARGET_ARCH STREQUAL "aarch64")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
    set(WK_DEFAULT_PREFIX aarch64-buildroot-linux-gnu)
    set(WK_ARCH_FLAGS "")
elseif(WK_TARGET_ARCH STREQUAL "armv7" OR WK_TARGET_ARCH STREQUAL "arm")
    set(CMAKE_SYSTEM_PROCESSOR arm)
    set(WK_DEFAULT_PREFIX arm-buildroot-linux-gnueabihf)
    set(WK_ARCH_FLAGS "-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard")
elseif(WK_TARGET_ARCH STREQUAL "x86_64" OR WK_TARGET_ARCH STREQUAL "amd64")
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
    set(WK_DEFAULT_PREFIX x86_64-buildroot-linux-gnu)
    set(WK_ARCH_FLAGS "")
else()
    message(FATAL_ERROR "WK_TARGET_ARCH must be arm64, armv7 or x86_64")
endif()

if(DEFINED ENV{WK_TOOLCHAIN_PREFIX})
    set(WK_TOOLCHAIN_PREFIX "$ENV{WK_TOOLCHAIN_PREFIX}")
else()
    set(WK_TOOLCHAIN_PREFIX "${WK_DEFAULT_PREFIX}")
endif()

set(WK_TOOLCHAIN_ROOT "$ENV{WK_TOOLCHAIN_ROOT}")
set(WK_SYSROOT "$ENV{WK_SYSROOT}")
set(CMAKE_C_COMPILER "${WK_TOOLCHAIN_ROOT}/bin/${WK_TOOLCHAIN_PREFIX}-gcc")
set(CMAKE_CXX_COMPILER "${WK_TOOLCHAIN_ROOT}/bin/${WK_TOOLCHAIN_PREFIX}-g++")
set(CMAKE_SYSROOT "${WK_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${WK_SYSROOT}")
set(CMAKE_C_FLAGS_INIT "${WK_ARCH_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${WK_ARCH_FLAGS}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
