generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE")
  devices   Device[]
  alarms    Alarm[]
  deviceLogs DeviceLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id                    String    @id @default(uuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceKey             String    @unique
  mqttClientId          String    @unique
  mqttUsername          String    @unique
  mqttPasswordHash      String
  mqttPasswordUpdatedAt DateTime  @default(now())
  deviceType            String    @default("DIRECT")
  gatewayId             String?
  gateway               Device?   @relation("GatewayChildren", fields: [gatewayId], references: [id], onDelete: SetNull)
  children              Device[]  @relation("GatewayChildren")
  name                  String
  protocol              String    @default("MQTT")
  status                String    @default("OFFLINE")
  location              String?
  lastSeenAt            DateTime?
  reportedConfig        Json?
  reportedConfigAt      DateTime?
  alarms                Alarm[]
  metrics               DeviceMetric[]
  alarmRules            DeviceAlarmRule[]
  logs                  DeviceLog[]
  factoryGateway        FactoryGateway?
  remoteConfigTasks     RemoteConfigTask[]
  topologyDrafts        GatewayTopologyDraft[] @relation("GatewayTopologyDraftGateway")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([deviceType])
  @@index([gatewayId])
}

model RemoteConfigTask {
  id                String    @id @default(uuid())
  deviceId          String
  device            Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  version           Int
  status            String    @default("PENDING")
  config             Json
  createdBy          String
  error              String?
  sentAt             DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([deviceId, version])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

model GatewayTopologyDraft {
  id                    String    @id @default(uuid())
  gatewayDeviceId       String
  gateway               Device    @relation("GatewayTopologyDraftGateway", fields: [gatewayDeviceId], references: [id], onDelete: Cascade)
  gatewayKey            String
  reportedConfigVersion String?
  items                 Json
  status                String    @default("PENDING")
  conflicts             Json?
  reportedAt            DateTime  @default(now())
  confirmedAt           DateTime?
  confirmedBy           String?
  ignoredAt             DateTime?
  ignoredBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([gatewayDeviceId])
  @@index([gatewayKey])
  @@index([status])
  @@index([reportedAt])
}

model FactoryGateway {
  id               String    @id @default(uuid())
  hardwareId       String    @unique
  sn               String    @unique
  deviceSecretHash String
  bindCodeHash     String
  status           String    @default("UNBOUND")
  batchNo          String?
  deviceId         String?   @unique
  device           Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  producedAt       DateTime?
  firstSeenAt      DateTime?
  lastSeenAt       DateTime?
  boundAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([batchNo])
  @@index([lastSeenAt])
}

model DeviceMetric {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  identifier String
  name       String
  dataType   String
  unit       String?
  decimals   Int      @default(2)
  accessMode String   @default("READ_ONLY")
  enabled    Boolean  @default(true)
  ignored    Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([deviceId, identifier])
  @@index([deviceId])
}

model DeviceAlarmRule {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  identifier String
  operator   String
  threshold  Float
  hysteresis Float    @default(0)
  level      String   @default("WARNING")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([deviceId])
  @@unique([deviceId, identifier, operator])
}

model Alarm {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type       String
  level      String    @default("WARNING")
  message    String
  status     String    @default("OPEN")
  value      Float?
  threshold  Float?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([deviceId])
  @@index([status])
}

model DeviceLog {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  deviceId   String?
  device     Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceKey  String
  deviceName String?
  type       String
  level      String   @default("INFO")
  source     String
  message    String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([deviceId])
  @@index([deviceKey])
  @@index([type])
  @@index([level])
  @@index([source])
  @@index([createdAt])
}
