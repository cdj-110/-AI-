{
  "name": "@weikong/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:tenant",
    "dev:tenant": "vite --mode tenant --configLoader runner",
    "dev:admin": "vite --mode admin --configLoader runner",
    "build": "npm run build:tenant",
    "test:device-groups": "node scripts/verify-device-groups.mjs",
    "build:tenant": "npm run typecheck && vite build --mode tenant --configLoader runner",
    "build:admin": "npm run typecheck && vite build --mode admin --configLoader runner",
    "build:all": "npm run build:tenant && npm run build:admin",
    "preview:tenant": "vite preview --mode tenant --configLoader runner --host 0.0.0.0 --port 5174",
    "preview:admin": "vite preview --mode admin --configLoader runner --host 0.0.0.0 --port 5176",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.3",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
