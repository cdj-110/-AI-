FROM node:22-bookworm-slim
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV CI=true HUSKY=0
WORKDIR /deps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --maxsockets=3 --fetch-retries=5 --fetch-retry-mintimeout=1000 --fetch-retry-maxtimeout=10000 && sha256sum package.json package-lock.json > manifests.sha256
WORKDIR /deps/api
COPY apps/api/package.json apps/api/package-lock.json ./
COPY apps/api/prisma ./prisma
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --maxsockets=3 --fetch-retries=5 --fetch-retry-mintimeout=1000 --fetch-retry-maxtimeout=10000 && sha256sum package.json package-lock.json > manifests.sha256
WORKDIR /deps/ingest
COPY apps/ingest/package.json apps/ingest/package-lock.json ./
COPY apps/ingest/prisma ./prisma
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --maxsockets=3 --fetch-retries=5 --fetch-retry-mintimeout=1000 --fetch-retry-maxtimeout=10000 && sha256sum package.json package-lock.json > manifests.sha256
COPY tools/ai-team/check-module.sh /usr/local/bin/check-module
RUN chmod +x /usr/local/bin/check-module
WORKDIR /check
ENTRYPOINT ["/usr/local/bin/check-module"]
