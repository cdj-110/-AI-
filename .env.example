DATABASE_URL="postgresql://weikong:CHANGE_ME_LOCAL_ONLY@localhost:5432/weikong_iot?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
# 专用 EMQX 连接管理密钥；JSON 文件包含 api_key、api_secret，不使用管理账号登录。
EMQX_API_URL=http://emqx:18083/api/v5
EMQX_API_CREDENTIALS_FILE=/var/lib/weikong/secrets/emqx-connection-api.json
# 不使用文件时需将 EMQX_API_CREDENTIALS_FILE 设为空，并提供以下两项。
EMQX_API_KEY=
EMQX_API_SECRET=
JWT_SECRET="CHANGE_ME_LOCAL_ONLY"
# 生产环境请设置独立的高强度随机密钥；未设置时兼容使用 JWT_SECRET 派生。
FACTORY_CREDENTIAL_ENCRYPTION_KEY=
# Ed25519 PKCS#8 DER 私钥的 Base64，仅配置在管理平台，严禁放入网关或提交仓库。
ACTIVATION_SIGNING_PRIVATE_KEY=
ACTIVATION_SIGNING_KEY_ID=
# 0 = 永久有效；正整数 = 有效天数（仅影响新签发文件）
ACTIVATION_LICENSE_DAYS=0
ACTIVATION_CLOUD_API=https://cloud.example.com/api
ACTIVATION_REMOTE_ACCESS_ENDPOINT=wss://cloud.example.com/remote-agent
# 独立 OTA Ed25519 公钥环 JSON；私钥只留在离线打包环境。
OTA_TRUSTED_PUBLIC_KEYS=
OTA_DOWNLOAD_SECRET=
OTA_PUBLIC_BASE_URL=https://cloud.example.com
JWT_EXPIRES_IN=12h
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=notice@example.com
MAIL_PASSWORD=
MAIL_PASSWORD_FILE="CHANGE_ME_LOCAL_ONLY"
MAIL_FROM="微控物联云平台 <notice@example.com>"
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60
# 支付宝沙箱联调。生产切换必须替换 APPID/PID/密钥/网关，并关闭沙箱金额覆盖。
ALIPAY_ENABLED=false
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SANDBOX_TEST_AMOUNT_CENTS=1
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
PORT=3100
VITE_API_BASE_URL=http://localhost:3100
# 独立 GoView 设计器地址；租户平台“设计/预览”会直接打开该地址。
VITE_GOVIEW_DESIGNER_URL=http://localhost:3020
MQTT_URL=mqtt://localhost:1883
MQTT_PUBLIC_HOST=127.0.0.1
MQTT_PUBLIC_PORT=1883
MQTT_USERNAME=platform-ingest
DEVICE_OFFLINE_TIMEOUT_SECONDS=90
DEVICE_OFFLINE_SCAN_INTERVAL_SECONDS=30
TEMPERATURE_HIGH_THRESHOLD=30
HUMIDITY_HIGH_THRESHOLD=80
BATTERY_LOW_THRESHOLD=20
TIMESCALE_DATABASE_URL="postgresql://weikong:CHANGE_ME_LOCAL_ONLY@localhost:5433/weikong_ts"

POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

EMQX_DASHBOARD_PASSWORD=CHANGE_ME_LOCAL_ONLY
